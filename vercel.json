{
  "crons": [
    {
      "path": "/api/cron/generate",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/social-post",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/broadcast/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}