# Dot 1 News — Editorial Portal — environment
# Copy to .env.local for local dev, or set these in Vercel (Production + Preview).

# The editorial portal's OWN Neon database (pooled connection string; host contains -pooler).
# This holds stories, sources, verification, review, corrections, accounts, and the audit log.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# The NEWS database we publish INTO (news.dot1.media). Separate Neon project/branch, pooled string.
# Publishing writes into its news_stories table. Optional at boot: without it the portal runs for
# editorial work and only the publish action is disabled.
NEWS_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Shared suite session secret. MUST be the SAME value as the other Dot One apps (portal, assets),
# so the single sign-on cookie on .dot1.media is recognized here. Without a match, SSO breaks.
SESSION_SECRET="the-same-value-as-the-rest-of-the-suite"
